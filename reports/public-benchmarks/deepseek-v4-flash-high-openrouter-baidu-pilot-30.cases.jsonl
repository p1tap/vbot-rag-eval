6 18 Wyoming none 18"],"label":null},"retrieval_any_gold":true,"retrieval_complete_gold":true,"citation_precision":1.0,"citation_recall":0.5,"cited_document_ids":["natural_questions:-4296931100877367527:candidate:0"],"answer_exact_match":0.0,"answer_f1":0.011428571428571429,"answerability_correct":true,"joint_correct":false}
