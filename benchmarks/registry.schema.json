{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vbot.local/schemas/public-benchmark-registry-v1.json",
  "title": "Vbot public benchmark registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "benchmarks"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "target_cases",
          "task_type",
          "source_version",
          "source_split",
          "homepage",
          "source_url",
          "upstream_source_url",
          "license",
          "human_annotation_provenance",
          "raw_sha256"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "active", "validated"]},
          "target_cases": {"type": "integer", "minimum": 1},
          "task_type": {
            "enum": ["extractive_qa", "multi_hop_qa", "fact_verification"]
          },
          "source_version": {"type": "string", "minLength": 1},
          "source_split": {"type": "string", "minLength": 1},
          "homepage": {"type": "string", "format": "uri"},
          "source_url": {"type": "string", "format": "uri"},
          "upstream_source_url": {"type": "string", "format": "uri"},
          "license": {"type": "string", "minLength": 1},
          "human_annotation_provenance": {"type": "string", "minLength": 1},
          "raw_sha256": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            ]
          }
        }
      }
    }
  }
}
