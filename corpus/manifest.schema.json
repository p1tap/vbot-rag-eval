{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/p1tap/vbot-rag-eval/corpus/manifest.schema.json",
  "title": "Vbot RAG corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "corpus_version",
    "created_at",
    "fingerprint_sha256",
    "fingerprint_method",
    "evidence_catalog",
    "documents",
    "security_scan",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "corpus_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "corpus_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "fingerprint_method": {
      "const": "sha256 of canonical JSON of documents sorted by document_id"
    },
    "evidence_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "sha256", "records", "builder"],
      "properties": {
        "path": {"const": "corpus/evidence-catalog-v1.jsonl"},
        "schema": {"const": "corpus/evidence-catalog.schema.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "records": {"type": "integer", "minimum": 1},
        "builder": {"const": "scripts/build_evidence_catalog.py"}
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/document"}
    },
    "security_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status", "finding_count", "scanner"],
      "properties": {
        "path": {"const": "reports/security/corpus-secret-scan.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "passed"},
        "finding_count": {"const": 0},
        "scanner": {"const": "scripts/scan_corpus_secrets.py"}
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableDate": {
      "oneOf": [
        {"type": "string", "format": "date"},
        {"type": "null"}
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "path",
        "format",
        "content_sha256",
        "line_count",
        "word_count",
        "status",
        "source",
        "authority",
        "sensitivity",
        "ingestion"
      ],
      "properties": {
        "document_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "path": {"type": "string", "pattern": "^corpus/[a-z0-9._-]+\\.md$"},
        "format": {"const": "markdown"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "line_count": {"type": "integer", "minimum": 1},
        "word_count": {"type": "integer", "minimum": 1},
        "status": {"enum": ["active", "superseded", "deleted", "fixture"]},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["declared_repository", "declared_path", "upstream_revision", "local_import_commit"],
          "properties": {
            "declared_repository": {"type": "string", "minLength": 1},
            "declared_path": {"type": ["string", "null"]},
            "upstream_revision": {"type": ["string", "null"]},
            "local_import_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["priority", "valid_from", "valid_until", "supersedes", "superseded_by"],
          "properties": {
            "priority": {"type": "integer", "minimum": 0},
            "valid_from": {"$ref": "#/$defs/nullableDate"},
            "valid_until": {"$ref": "#/$defs/nullableDate"},
            "supersedes": {
              "type": "array",
              "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
              "uniqueItems": true
            },
            "superseded_by": {"type": ["string", "null"]}
          }
        },
        "sensitivity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "secret_scan_status"],
          "properties": {
            "classification": {"enum": ["public_safe", "private", "restricted", "fixture"]},
            "secret_scan_status": {"enum": ["not_automated", "passed", "failed"]}
          }
        },
        "ingestion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "access_class"],
          "properties": {
            "allowed": {"type": "boolean"},
            "access_class": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
