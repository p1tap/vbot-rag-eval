{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/p1tap/vbot-rag-eval/evals/schema/v1-review-source-map.schema.json",
  "title": "Vbot RAG V1 human-review source map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "dataset_id",
    "dataset_version",
    "dataset_fingerprint_sha256",
    "corpus_id",
    "corpus_version",
    "corpus_fingerprint_sha256",
    "evidence_catalog_sha256",
    "case_count",
    "answerable_cases",
    "unanswerable_cases",
    "cases",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "purpose": {"const": "source-backed human review navigation; not approved annotation"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "dataset_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_id": {"type": "string", "minLength": 1},
    "corpus_version": {"type": "string", "minLength": 1},
    "corpus_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "case_count": {"type": "integer", "minimum": 1},
    "answerable_cases": {"type": "integer", "minimum": 0},
    "unanswerable_cases": {"type": "integer", "minimum": 0},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "legacy_id",
          "question",
          "answerability",
          "current_answer_action",
          "legacy_reference_answer",
          "legacy_relevant_headings",
          "candidate_evidence",
          "current_review_status",
          "human_decision_required",
          "model_proposal_status"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "legacy_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "answerability": {"enum": ["answerable", "unanswerable"]},
          "current_answer_action": {"type": "string", "minLength": 1},
          "legacy_reference_answer": {"type": "string", "minLength": 1},
          "legacy_relevant_headings": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "candidate_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["heading_key", "candidate_blocks"],
              "properties": {
                "heading_key": {"type": "string", "minLength": 1},
                "candidate_blocks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "block_type",
                      "start_line",
                      "end_line",
                      "text"
                    ],
                    "properties": {
                      "evidence_id": {"type": "string", "minLength": 1},
                      "block_type": {"type": "string", "minLength": 1},
                      "start_line": {"type": "integer", "minimum": 1},
                      "end_line": {"type": "integer", "minimum": 1},
                      "text": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          },
          "current_review_status": {"const": "migrated_pending_v2_review"},
          "human_decision_required": {"const": true},
          "model_proposal_status": {"const": "source_navigation_only"}
        }
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

