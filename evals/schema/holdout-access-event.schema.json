{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/p1tap/vbot-rag-eval/evals/schema/holdout-access-event.schema.json",
  "title": "Vbot RAG sealed-holdout access event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "timestamp",
    "actor_id",
    "actor_type",
    "event_type",
    "dataset_id",
    "dataset_version",
    "dataset_fingerprint_sha256",
    "split",
    "scope",
    "purpose",
    "authorization_reference",
    "case_count",
    "outcome",
    "previous_event_sha256",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "pattern": "^ha-[0-9]{6}-[a-f0-9]{12}$"},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$"},
    "actor_type": {"enum": ["human", "codex", "service"]},
    "event_type": {
      "enum": [
        "ledger_initialized",
        "access_requested",
        "access_granted",
        "access_denied",
        "evaluation_started",
        "evaluation_completed",
        "aggregate_released",
        "contamination_reported"
      ]
    },
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "dataset_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "split": {
      "type": ["string", "null"],
      "enum": [null, "release", "adversarial", "real_user", "reserve"]
    },
    "scope": {
      "enum": [
        "none",
        "aggregate",
        "case_ids",
        "case_content",
        "per_case_results",
        "raw_outputs"
      ]
    },
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "authorization_reference": {"type": ["string", "null"], "maxLength": 200},
    "case_count": {"type": ["integer", "null"], "minimum": 0},
    "outcome": {
      "enum": [
        "initialized",
        "requested",
        "granted",
        "denied",
        "completed",
        "released",
        "contaminated"
      ]
    },
    "previous_event_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "event_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

